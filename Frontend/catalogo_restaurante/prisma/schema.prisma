
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique   // ✅ ahora cada slug debe ser único
  products Product[]
}

model Product {
   id  Int @id   @default(autoincrement())
   name String 
   price Float
   image String
   description String
   type String
   categoryId Int
   category Category @relation(fields: [categoryId], references: [id])
}